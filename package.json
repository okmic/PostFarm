{
  "name": "postfarm",
  "version": "1.0.0",
  "main": "index.js",
  "author": "okmic <okmic.g@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n gateway,postfarm,root -c green,yellow,cyan \"yarn gateway:server:dev\" \"yarn front:postfarm:dev\" \"yarn front:root:dev\"",
    "gateway:server:dev": "cd services/app && yarn gateway:server:dev",
    "front:postfarm:dev": "cd fronts/postfarm && yarn dev",
    "front:root:dev": "cd fronts/root && yarn dev",
    "front:posthub:dev": "cd fronts/posthub && yarn dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}